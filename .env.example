# =============================================================================
# TestPilot configuration example. Copy to `.env` (git-ignored) and fill in.
# Never commit real secrets.
# =============================================================================

# --- Docker Compose (docker-compose.yml reads this file automatically) --------
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Use URL-safe characters for POSTGRES_PASSWORD (it is embedded in DATABASE_URL).
POSTGRES_PASSWORD=change-me-url-safe-password
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# Encrypts stored AI provider API keys (AES-256-GCM). Generate with:
#   python -c "import os,base64; print('v1:' + base64.urlsafe_b64encode(os.urandom(32)).decode())"
# To rotate: put the new key first and keep the old one after a comma until keys are re-saved.
ENCRYPTION_KEYS=v1:replace-with-generated-key
TESTPILOT_PORT=8080
# Keep false only for plain-HTTP localhost. Set true whenever TestPilot is served over HTTPS.
COOKIE_SECURE=false
ALLOW_REGISTRATION=true
ENABLE_API_DOCS=true
LOG_LEVEL=INFO

# --- Local development without Docker (put these in backend/.env) -------------
# APP_ENV=development
# DATABASE_URL=sqlite+aiosqlite:///./data/testpilot.db
#   or PostgreSQL: postgresql+asyncpg://testpilot:password@localhost:5432/testpilot
# REDIS_URL=redis://localhost:6379/0        # optional in development
# JWT_SECRET=...                             # optional in development (ephemeral if unset)
# ENCRYPTION_KEYS=...                        # optional in development (key file in backend/data/)
# COOKIE_SECURE=false
# LOG_FORMAT=console                         # json (default) or console
# CORS_ORIGINS=                              # only if the SPA is served from another origin

# --- Auth tuning (defaults shown) --------------------------------------------
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=1209600
# REFRESH_REUSE_GRACE_SECONDS=20
# LOGIN_MAX_FAILURES_PER_EMAIL=5
# LOGIN_MAX_FAILURES_PER_IP=20
# LOGIN_FAILURE_WINDOW_SECONDS=900

# --- Test execution (milestone 4) ---------------------------------------------
# Docker compose always uses EXECUTION_MODE=celery + BROWSER_TRANSPORT=redis (isolated worker).
# BROWSER_MAX_SESSIONS=2                     # parallel browser sessions in browser-worker
# Local development without Docker (backend/.env) uses the defaults below: runs execute inside
# the API process and the browser runs on a thread of it. Development only, no isolation.
# EXECUTION_MODE=inline
# BROWSER_TRANSPORT=thread
# ARTIFACTS_DIR=./data/artifacts
# BROWSER_ALLOW_PRIVATE_NETWORK=false        # true to test apps on localhost / private networks
#                                            # (cloud metadata addresses stay blocked)
# RUN_MAX_SECONDS=600
# MAX_ACTIVE_RUNS_PER_USER=5
# ARTIFACT_RETENTION_DAYS=30                 # 0 keeps screenshots/traces forever
#   Docker: docker compose exec worker python -m app.maintenance cleanup-artifacts (e.g. daily cron)

# --- AI providers ---------------------------------------------------------------
# AI_ALLOW_LOCAL_PROVIDERS=                  # Ollama/LM Studio on loopback/LAN addresses.
#                                            # Default: on in development, off in production.

